  "topPRs": [
    {
      "id": "PR_kwDOL-xLQ86-dSuE",
      "title": "fix(op-acceptor): ensure logs are written to disk for timeout cases",
      "author": "scharissis",
      "number": 540,
      "body": "When tests timeout and CI kills the process (SIGKILL, exit code 137),\nbuffered writes in AsyncFile were being lost because the background\ngoroutine never had a chance to flush them.\n\nThis adds:\n- AsyncFile.Flush() to block until queued writes are synced to disk\n- FileLogger.FlushAll() to flush all async writers\n- FileLogger.LogTestResultSync() for synchronous logging of timeout results\n- Graceful shutdown flush in nat.Stop() to persist logs before exit\n\nThis ensures per-test log files exist in logs/testrun-*/failed/ even\nwhen tests are terminated due to timeout.\n",
      "repository": "ethereum-optimism/infra",
      "createdAt": "2026-01-21T13:51:10Z",
      "mergedAt": "2026-01-21T14:24:38Z",
      "additions": 56,
      "deletions": 1
    }
