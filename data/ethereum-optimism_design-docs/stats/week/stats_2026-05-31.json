    {
      "id": "PR_kwDOLyTYAM6lKDQZ",
      "title": "Reactive Security Council",
      "author": "alcueca",
      "number": 327,
      "body": "This is a proposal to turn the L1PAO into a 1/2 following the enabling of #324, and replacing the current active role of the Security Council to a reactive one where they only cancel malicious transactions when alerted.\r\n\r\nThis new process would be supported by EVM Safety, bug bounty hunters, and external contractors. I believe that we would be safer.\r\n",
      "repository": "ethereum-optimism/design-docs",
      "createdAt": "2025-08-25T07:28:26Z",
      "mergedAt": null,
      "additions": 99,
      "deletions": 0
    },
    {
      "id": "PR_kwDOLyTYAM5_wfGj",
      "title": "feat: updated Solidity interface policy",
      "author": "smartcontracts",
      "number": 139,
      "body": "Introduces a new proposal to update the Solidity interface policy such that source contracts do not use interfaces at all and interfaces live in an entirely separate folder. Proposal is intended to set us up to fully automate interface generation while still maintaining most of the compilation benefits.",
      "repository": "ethereum-optimism/design-docs",
      "createdAt": "2024-10-24T11:32:07Z",
      "mergedAt": null,
      "additions": 84,
      "deletions": 0
    },
    {
      "id": "PR_kwDOLyTYAM6L9Tep",
      "title": "feat: interop launch sequence",
      "author": "smartcontracts",
      "number": 207,
      "body": "Proposes an interop launch sequence. Will require additional feedback from other teams.",
      "repository": "ethereum-optimism/design-docs",
      "createdAt": "2025-02-20T21:08:37Z",
      "mergedAt": null,
