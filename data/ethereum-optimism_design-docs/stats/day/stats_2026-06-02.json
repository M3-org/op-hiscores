    {
      "id": "PR_kwDOLyTYAM6ARJvl",
      "title": "Proposal to move types and errors files to dedicated folders",
      "author": "AmadiMichael",
      "number": 145,
      "body": "This design doc proposes moving types and errors files out of `*/libraries/` and `*/lib/` files and into dedicated folders named `*/types/` and `*/errors/`.\r\n\r\nIssues:\r\n- https://github.com/ethereum-optimism/optimism/issues/12642\r\n- https://github.com/ethereum-optimism/optimism/issues/12645\r\n",
      "repository": "ethereum-optimism/design-docs",
