    {
      "id": "PR_kwDOKIsnqM7UuNuX",
      "title": "feat: scaffold OPCMMigrateV700 task template",
      "author": "stevennevins",
      "number": 1404,
      "body": "Implement the superchain-ops template for the shared dispute game migration\r\n\r\n`OPCM.migrate(MigrateInput)` (added in OPCM v7.1.16) merges N pre-interop\r\nchains into a single interop set by deploying a shared\r\n`DisputeGameFactory`, `AnchorStateRegistry`, and `ETHLockbox`. This PR\r\nadds `OPCMMigrateV700`\r\ndrives that migration end-to-end: one delegate-call for all chains, then\r\nvalidation via the `OPContractsManagerMigrationValidator`.\r\n\r\nCloses ethereum-optimism/optimism#19017\r\n",
      "repository": "ethereum-optimism/superchain-ops",
      "createdAt": "2026-04-22T18:12:06Z",
      "mergedAt": "2026-05-07T20:37:37Z",
      "additions": 738,
      "deletions": 0
    },
    {
      "id": "PR_kwDOKIsnqM7Ss58y",
      "title": "Deputy pause key rotation tasks for eth and sep",
      "author": "JosepBove",
      "number": 1396,
      "body": "",
